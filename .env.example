# Variables de docker-compose.yml.
# Copier ce fichier en .env (non versionné) et remplacer les valeurs : ne jamais versionner .env.

# Mot de passe root du conteneur MySQL (administration uniquement, jamais utilisé par l'application).
MYSQL_ROOT_PASSWORD=change-moi-root

# Mot de passe de fitbook_user, à reporter dans DATABASE_URL de backend/.env.local.
FITBOOK_DB_PASSWORD=change-moi-fitbook

# Port MySQL exposé sur la machine (3307 pour ne pas gêner un MySQL local sur 3306).
MYSQL_PORT=3307
