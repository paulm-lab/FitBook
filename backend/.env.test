# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Base isolée en mémoire et e-mails conservés en mémoire : aucun envoi réel pendant les tests.
DATABASE_URL="sqlite:///:memory:"
MESSENGER_TRANSPORT_DSN=in-memory://

# Clés JWT propres aux tests, générées automatiquement par tests/bootstrap.php (non versionnées).
# Passphrase sans valeur de secret : ces clés ne servent qu'aux tests.
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt-test/public.pem
JWT_PASSPHRASE=passphrase-des-tests
