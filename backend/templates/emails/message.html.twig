{# Langue du destinataire (FitBookMailer) : les mentions fixes sont traduites avec la même langue. -#}
{% set locale = locale|default('fr') -%}
<!doctype html><html lang="{{ locale }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{{ title }}</title></head>
<body style="margin:0;background:#f3f5f8;color:#10213a;font-family:Arial,Helvetica,sans-serif"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f3f5f8;padding:32px 12px"><tr><td align="center"><table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#fff;border-radius:16px;overflow:hidden"><tr><td style="background:#10213a;padding:24px 32px"><span style="display:inline-block;vertical-align:middle;width:36px;height:36px;line-height:36px;text-align:center;border-radius:9px;background:#ff642d;color:#fff;font-weight:bold;font-size:20px">F</span><span style="margin-left:10px;color:#fff;font-weight:bold;font-size:24px;vertical-align:middle">FitBook</span></td></tr>
<tr><td style="padding:36px 32px 28px"><h1 style="margin:0 0 18px;color:#10213a;font-size:25px">{{ title }}</h1><p style="margin:0;color:#536174;font-size:16px;line-height:1.7">{{ message }}</p>{% if details is not empty %}<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:22px 0;background:#f5f7fa;border-radius:10px">{% for label, value in details %}<tr><td style="padding:9px 14px;color:#536174">{{ label }}</td><td style="padding:9px 14px;color:#10213a;font-weight:bold;text-align:right">{{ value }}</td></tr>{% endfor %}</table>{% endif %}{% if actionUrl and actionLabel %}<p style="margin:28px 0"><a href="{{ actionUrl }}" style="display:inline-block;padding:14px 22px;border-radius:28px;background:#ff642d;color:#fff;font-weight:bold;text-decoration:none">{{ actionLabel }}</a></p>{% endif %}<p style="margin:24px 0 0;color:#8792a2;font-size:13px;line-height:1.6">{{ 'Si vous n’êtes pas à l’origine de cette demande, vous pouvez ignorer cet e-mail.'|trans({}, 'messages', locale) }}</p></td></tr><tr><td style="background:#f5f7fa;padding:18px 32px;color:#8792a2;font-size:12px">FitBook · {{ 'Bougez plus. Vivez mieux.'|trans({}, 'messages', locale) }}</td></tr></table></td></tr></table></body></html>